{
    "name": "mathsite",
    "version": "1.0.0",
    "private": true,
    "description": "React + Express + MySQL 학원 사이트",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/server.js",
        "prestart": "npm run build",
        "dev": "node --watch-path=src src/server.js --dev",
        "build": "vite build",
        "db:start": "node scripts/local-db.js start",
        "db:stop": "node scripts/local-db.js stop",
        "db:init": "node scripts/init-db.js",
        "media:start": "node scripts/nginx.js start",
        "media:stop": "node scripts/nginx.js stop",
        "media:check": "node scripts/nginx.js check",
        "test": "npm run test:api && npm run test:kakao && npm run test:features && npm run test:social",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:api": "mocha --timeout 15000 tests/api.test.js",
        "test:kakao": "mocha --timeout 15000 tests/kakao.test.js",
        "test:features": "mocha --timeout 60000 tests/features.test.js",
        "test:social": "mocha --timeout 15000 tests/social.test.js",
        "pretest": "npm run build"
    },
    "dependencies": {
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "express-session": "^1.19.0",
        "hls.js": "^1.7.4",
        "multer": "^2.5.0",
        "mysql2": "^3.24.6",
        "nodemailer": "^10.5.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-router-dom": "7.18.5",
        "sequelize": "^6.37.8"
    },
    "devDependencies": {
        "@vitejs/plugin-react": "6.3.0",
        "mocha": "12.0.3",
        "prettier": "3.9.10",
        "vite": "8.3.8"
    }
}
