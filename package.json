{
    "name": "mathsite",
    "version": "1.0.0",
    "private": true,
    "description": "로컬 MySQL 기반 학원 홈페이지 백엔드",
    "main": "src/app.js",
    "scripts": {
        "start": "node src/server.js",
        "db:start": "node scripts/local-db.js start",
        "db:stop": "node scripts/local-db.js stop",
        "db:init": "node scripts/init-db.js",
        "test": "npm run test:api && npm run test:kakao",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:api": "mocha --timeout 15000 tests/api.test.js",
        "test:kakao": "mocha --timeout 15000 tests/kakao.test.js"
    },
    "dependencies": {
        "dotenv": "^18.0.9",
        "express": "^5.3.0",
        "express-session": "^1.19.0",
        "multer": "^2.5.0",
        "mysql2": "^3.24.6"
    },
    "devDependencies": {
        "mocha": "12.0.3",
        "prettier": "3.9.10"
    }
}
