PORT=3000
DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSL=true
DB_SSL_CA=database/certs/filess-ca.pem
DB_CONNECTION_LIMIT=1
SESSION_SECRET=GENERATE_A_RANDOM_SECRET
# 비어 있는 새 DB에서 최초 관리자 생성 시에만 설정한다.
ADMIN_NAME=관리자
ADMIN_EMAIL=
ADMIN_PASSWORD=
UPLOAD_DIR=.local/uploads

# 카카오 개발자 앱 생성 후 입력. Client Secret 활성화 상태로 사용한다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:3000/auth/kakao/callback
