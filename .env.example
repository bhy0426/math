PORT=3000
APP_URL=http://127.0.0.1:3000
DB_HOST=YOUR_DB_HOST
DB_PORT=3306
DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_SSL=true
DB_SSL_CA=database/certs/filess-ca.pem
DB_CONNECTION_LIMIT=1
SESSION_SECRET=GENERATE_A_RANDOM_SECRET
# 비어 있는 새 DB에서 최초 관리자 생성 시에만 설정한다.
ADMIN_NICKNAME=관리자
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
UPLOAD_DIR=.local/uploads

# 영상 도구는 PATH에 등록하거나 실행 파일 절대 경로를 입력한다.
FFMPEG_PATH=ffmpeg
NGINX_PATH=nginx
NGINX_PORT=8080
# 비우면 UPLOAD_DIR/hls 사용. 원본과 HLS 폴더를 함께 백업한다.
HLS_DIR=

# 가입 인증코드·관리자 초기화 메일을 보내는 서버 계정. Gmail 설정은 docs/HANDOFF.md 참고.
MAIL_TRANSPORT=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# 카카오 개발자 앱 생성 후 입력. Client Secret 활성화 상태로 사용한다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://127.0.0.1:3000/auth/kakao/callback

# Google Cloud OAuth 웹 클라이언트. openid 식별자만 사용하고 개인정보는 별도 입력한다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
